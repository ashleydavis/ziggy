{
  "name": "ziggy",
  "version": "0.1.0",
  "private": true,
  "description": "Ziggy is a framework for building cross-platform apps with JavaScript/TypeScript, HTML and CSS for the user interface and Zig for everything else. One app runs on Linux, Windows, macOS, Android and iOS, using each platform's system web view.",
  "license": "MIT",
  "main": "packages/ziggy/bridge/src/index.ts",
  "types": "packages/ziggy/bridge/src/index.ts",
  "scripts": {
    "setup": "bun --filter '*' setup",
    "compile": "bun --filter '*' compile",
    "c": "bun run compile",
    "test": "bun --filter '*' test",
    "t": "bun run test",
    "test:zig": "zig build test --summary all",
    "test:android-shell": "bun run --filter=ziggy-example test:android-shell",
    "test:zig:android": "bash ./apps/ziggy-example/scripts/test-zig-mobile.sh android --ziggy-dir .",
    "test:zig:ios": "bash ./apps/ziggy-example/scripts/test-zig-mobile.sh ios --ziggy-dir .",
    "compile:zig": "bun run --filter=ziggy-example compile:zig",
    "sync:ziggy-example:linux": "bun run --filter=ziggy-example sync:linux",
    "sync:ziggy-example:windows": "bun run --filter=ziggy-example sync:windows",
    "sync:ziggy-example:macos": "bun run --filter=ziggy-example sync:macos",
    "sync:ziggy-example:ios": "bun run --filter=ziggy-example sync:ios",
    "sync:ziggy-example:android": "bun run --filter=ziggy-example sync:android",
    "build:ziggy-example:linux": "bun run --filter=ziggy-example build:linux",
    "build:ziggy-example:windows": "bun run --filter=ziggy-example build:windows",
    "build:ziggy-example:macos": "bun run --filter=ziggy-example build:macos",
    "build:ziggy-example:ios": "bun run --filter=ziggy-example build:ios",
    "build:ziggy-example:android": "bun run --filter=ziggy-example build:android",
    "run:ziggy-example:linux": "bun run --filter=ziggy-example run:linux",
    "run:ziggy-example:windows": "bun run --filter=ziggy-example run:windows",
    "run:ziggy-example:macos": "bun run --filter=ziggy-example run:macos",
    "run:ziggy-example:ios": "bun run --filter=ziggy-example run:ios",
    "run:ziggy-example:android": "bun run --filter=ziggy-example run:android",
    "open:ziggy-example:linux": "bun run --filter=ziggy-example open:linux",
    "open:ziggy-example:windows": "bun run --filter=ziggy-example open:windows",
    "open:ziggy-example:macos": "bun run --filter=ziggy-example open:macos",
    "open:ziggy-example:ios": "bun run --filter=ziggy-example open:ios",
    "open:ziggy-example:android": "bun run --filter=ziggy-example open:android",
    "package:ziggy-example:linux": "bun run --filter=ziggy-example package:linux",
    "package:ziggy-example:windows": "bun run --filter=ziggy-example package:windows",
    "package:ziggy-example:macos": "bun run --filter=ziggy-example package:macos",
    "package:ziggy-example:ios": "bun run --filter=ziggy-example package:ios",
    "package:ziggy-example:android": "bun run --filter=ziggy-example package:android",
    "distribute:ziggy-example:android": "bun run --filter=ziggy-example distribute:android",
    "clean:ziggy-example:linux": "bun run --filter=ziggy-example clean:linux",
    "clean:ziggy-example:windows": "bun run --filter=ziggy-example clean:windows",
    "clean:ziggy-example:macos": "bun run --filter=ziggy-example clean:macos",
    "clean:ziggy-example:ios": "bun run --filter=ziggy-example clean:ios",
    "clean:ziggy-example:android": "bun run --filter=ziggy-example clean:android",
    "test:ziggy-example": "bash ./apps/ziggy-example/smoke-tests/run-desktop.sh",
    "test:ziggy-example:and": "bash ./apps/ziggy-example/smoke-tests/run.sh android",
    "test:ziggy-example:ios": "bash ./apps/ziggy-example/smoke-tests/run.sh ios"
  },
  "workspaces": [
    "apps/*",
    "packages/ziggy/bridge"
  ]
}
