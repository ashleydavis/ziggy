{
  "name": "ziggy-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Ziggy is a framework for building cross-platform apps with JavaScript/TypeScript, HTML and CSS for the user interface and Zig for everything else. One app runs on Linux, Windows, macOS, Android and iOS, using each platform's system web view.",
  "license": "MIT",
  "main": "packages/ziggy/frontend/src/index.ts",
  "types": "packages/ziggy/frontend/src/index.ts",
  "bin": {
    "ziggy-remote-control-server": "tools/remote-control-server/src/index.ts"
  },
  "scripts": {
    "setup": "bun --filter '*' setup",
    "compile": "bun --filter '*' compile",
    "c": "bun run compile",
    "test": "bun --filter '*' test",
    "t": "bun run test",
    "test:zig": "zig build test --summary all",
    "test:android-shell": "bash ./scripts/test-android-shell.sh",
    "test:zig:android": "bash ./scripts/test-zig-mobile.sh android --ziggy-dir .",
    "test:zig:ios": "bash ./scripts/test-zig-mobile.sh ios --ziggy-dir .",
    "compile:zig": "bun run --filter=ziggy-template compile:zig && bun run --filter=ziggy-test-app compile:zig",
    "sync:ziggy-template:linux": "bun run --filter=ziggy-template sync:linux",
    "sync:ziggy-template:windows": "bun run --filter=ziggy-template sync:windows",
    "sync:ziggy-template:macos": "bun run --filter=ziggy-template sync:macos",
    "sync:ziggy-template:ios": "bun run --filter=ziggy-template sync:ios",
    "sync:ziggy-template:android": "bun run --filter=ziggy-template sync:android",
    "build:ziggy-template:linux": "bun run --filter=ziggy-template build:linux",
    "build:ziggy-template:windows": "bun run --filter=ziggy-template build:windows",
    "build:ziggy-template:macos": "bun run --filter=ziggy-template build:macos",
    "build:ziggy-template:ios": "bun run --filter=ziggy-template build:ios",
    "build:ziggy-template:android": "bun run --filter=ziggy-template build:android",
    "run:ziggy-template:linux": "bun run --filter=ziggy-template linux",
    "run:ziggy-template:windows": "bun run --filter=ziggy-template windows",
    "run:ziggy-template:macos": "bun run --filter=ziggy-template macos",
    "run:ziggy-template:ios": "bun run --filter=ziggy-template ios",
    "run:ziggy-template:android": "bun run --filter=ziggy-template android",
    "open:ziggy-template:linux": "bun run --filter=ziggy-template open:linux",
    "open:ziggy-template:windows": "bun run --filter=ziggy-template open:windows",
    "open:ziggy-template:macos": "bun run --filter=ziggy-template open:macos",
    "open:ziggy-template:ios": "bun run --filter=ziggy-template open:ios",
    "open:ziggy-template:android": "bun run --filter=ziggy-template open:android",
    "package:ziggy-template:linux": "bun run --filter=ziggy-template package:linux",
    "package:ziggy-template:windows": "bun run --filter=ziggy-template package:windows",
    "package:ziggy-template:macos": "bun run --filter=ziggy-template package:macos",
    "package:ziggy-template:ios": "bun run --filter=ziggy-template package:ios",
    "package:ziggy-template:android": "bun run --filter=ziggy-template package:android",
    "package:ziggy-template:archive": "bash ./scripts/package-template.sh",
    "distribute:ziggy-template:android": "bun run --filter=ziggy-template distribute:android",
    "clean:ziggy-template:linux": "bun run --filter=ziggy-template clean:linux",
    "clean:ziggy-template:windows": "bun run --filter=ziggy-template clean:windows",
    "clean:ziggy-template:macos": "bun run --filter=ziggy-template clean:macos",
    "clean:ziggy-template:ios": "bun run --filter=ziggy-template clean:ios",
    "clean:ziggy-template:android": "bun run --filter=ziggy-template clean:android",
    "test:smoke": "bash ./smoke-tests/run-desktop.sh",
    "test:smoke:android": "bash ./smoke-tests/run.sh android",
    "test:smoke:ios": "bash ./smoke-tests/run.sh ios",
    "dev:ziggy-template": "bun run --filter=ziggy-template dev",
    "diagrams": "bash ./scripts/render-diagrams.sh",
    "install-hooks": "bash ./scripts/install-hooks.sh",
    "test:everything": "bash ./scripts/test-everything.sh"
  },
  "dependencies": {
    "express": "5.3.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "ziggy-remote-control-server": "workspace:*"
  },
  "workspaces": [
    "apps/*",
    "packages/ziggy/frontend",
    "tools/*"
  ]
}
