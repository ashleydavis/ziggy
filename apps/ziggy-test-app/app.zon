// The app's details, which Ziggy's build reads: its name, which names its log files, and its title, which heads them.
.{
    .name = "ziggy-test-app",
    .title = "Ziggy test app",
    .splash = .{
        .background = "#FFFFFF",
        .portrait = "assets/splash-portrait.png",
        .landscape = "assets/splash-landscape.png",
    },
}
