// The app's details, which Ziggy's build reads: its name, which names its log files, and its title, which heads them.
.{
    .name = "ziggy-template",
    .title = "Ziggy template",
    .splash = .{
        .background = "#1B1035",
        .portrait = "assets/splash-portrait.png",
        .landscape = "assets/splash-landscape.png",
        // The splash background where the splash and the web view leave the window uncovered, and under the menu bar until the
        // splash fades, so neither shows as a colour of its own.
        .window_background = "#1B1035",
        .menu_cover = "#1B1035",
    },
}
