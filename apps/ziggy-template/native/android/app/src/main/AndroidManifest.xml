<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The remote control connection, which the app opens to the remote control server only when started with the
         ziggy.remoteControl extra, is a socket, and Android refuses an app a socket without this permission. The app reaches no
         other host: its frontend is in the APK and external links open in the system browser. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="Ziggy template"
        android:allowBackup="false"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true">
        <!-- exported is required for an activity with an intent filter from Android 12, and the launcher needs it. The
             configuration changes are handled in place, because recreating the activity would destroy the core. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|layoutDirection">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
