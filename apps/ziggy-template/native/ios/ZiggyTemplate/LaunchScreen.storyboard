<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="21507" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" launchScreen="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="Lnc-hS-Vc1">
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="21505"/>
        <capability name="Named colors" minToolsVersion="9.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <!--The launch screen: the splash art over the whole screen, scaled to cover it as the app's backdrop and the frontend's
            overlay draw it, so the art does not move when the app takes over from the system.-->
        <scene sceneID="Lnc-hS-Sc1">
            <objects>
                <viewController id="Lnc-hS-Vc1" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="Lnc-hS-Vw1">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFill" horizontalHuggingPriority="251" verticalHuggingPriority="251" image="Splash" translatesAutoresizingMaskIntoConstraints="NO" id="Lnc-hS-Im1">
                                <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                            </imageView>
                        </subviews>
                        <color key="backgroundColor" name="SplashBackground"/>
                        <constraints>
                            <constraint firstItem="Lnc-hS-Im1" firstAttribute="top" secondItem="Lnc-hS-Vw1" secondAttribute="top" id="Lnc-hS-Ct1"/>
                            <constraint firstItem="Lnc-hS-Im1" firstAttribute="bottom" secondItem="Lnc-hS-Vw1" secondAttribute="bottom" id="Lnc-hS-Ct2"/>
                            <constraint firstItem="Lnc-hS-Im1" firstAttribute="leading" secondItem="Lnc-hS-Vw1" secondAttribute="leading" id="Lnc-hS-Ct3"/>
                            <constraint firstItem="Lnc-hS-Im1" firstAttribute="trailing" secondItem="Lnc-hS-Vw1" secondAttribute="trailing" id="Lnc-hS-Ct4"/>
                        </constraints>
                    </view>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="Lnc-hS-Fr1" userLabel="First Responder" sceneMemberID="firstResponder"/>
            </objects>
        </scene>
    </scenes>
    <resources>
        <image name="Splash" width="1290" height="2796"/>
        <namedColor name="SplashBackground">
            <color red="0.10588235294117647" green="0.062745098039215685" blue="0.20784313725490197" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
        </namedColor>
    </resources>
</document>
