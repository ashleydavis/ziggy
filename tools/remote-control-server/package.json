{
    "name": "ziggy-remote-control-server",
    "version": "1.0.0",
    "description": "Relays a smoke test script's command lines to a Ziggy app started with --remote-control, and the app's replies back.",
    "type": "module",
    "private": true,
    "bin": {
        "ziggy-remote-control-server": "src/index.ts"
    },
    "scripts": {
        "t": "bun run test",
        "test": "jest",
        "c": "bun run compile",
        "compile": "tsc"
    },
    "license": "MIT",
    "dependencies": {
        "express": "5.3.0",
        "ws": "8.22.0"
    },
    "devDependencies": {
        "@types/express": "5.0.6",
        "@types/jest": "29.5.14",
        "@types/node": "22.20.5",
        "@types/ws": "8.18.2",
        "jest": "29.7.0",
        "ts-jest": "29.4.14",
        "typescript": "5.9.3"
    }
}
